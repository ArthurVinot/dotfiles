eval "$(pass show env/bashrc_secrets 2>/dev/null)"

refresh_bashrc_secrets() {
    python3 -c "
import subprocess
secrets_map = {
    \"OPENAI_API_KEY\": \"api_key/openai\",
    \"ANTHROPIC_API_KEY\": \"api_key/anthropic\",
    \"GEMINI_API_KEY\": \"api_key/gemini\",
    \"DEEPSEEK_API_KEY\": \"api_key/deepseek\",
    \"OPENROUTER_API_KEY\": \"api_key/openrouter\",
    \"AWS_ACCESS_KEY_ID\": \"api_key/bedrock/aws_access_key_id\",
    \"AWS_SECRET_ACCESS_KEY\": \"api_key/bedrock/aws_secret_access_key\",
    \"GITLAB_TOKEN\": \"gitlab/laptop_push_token\",
    \"XXII_PYPI_PASSWORD\": \"gitlab/pypi_pull_token\",
    \"JIRA_API_TOKEN\": \"api_key/jira\"
}
lines = []
for var, pass_path in secrets_map.items():
    try:
        val = subprocess.check_output([\"pass\", \"show\", pass_path], stderr=subprocess.DEVNULL).decode(\"utf-8\").split(\"\n\")[0].strip()
        if val:
            escaped_val = val.replace(\"\x27\", \"\x27\\\\\\\x27\x27\")
            lines.append(f\"export {var}=\x27{escaped_val}\x27\")
    except Exception:
        pass
lines.append(\"export AWS_REGION_NAME=\x27eu-west-3\x27\")
content = \"\n\".join(lines) + \"\n\"
p = subprocess.Popen([\"pass\", \"insert\", \"-f\", \"-m\", \"env/bashrc_secrets\"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
stdout, stderr = p.communicate(input=content.encode(\"utf-8\"))
if p.returncode == 0:
    print(\"Secrets refreshed successfully!\")
else:
    print(\"Failed to refresh secrets:\", stderr.decode(\"utf-8\")[:500])
"
}
{{- end }}

