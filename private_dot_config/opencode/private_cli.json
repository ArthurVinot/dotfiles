{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "dark"
  },
  "keybinds": {
    "command.palette.show": "ctrl+q"
  },
  "diffs": {
    "wrap": "word",
    "single": true
  },
